# Gov jobs portal frontend — Vercel project environment (production).
# Set these in Vercel -> Project -> Settings -> Environment Variables.

# Public URL of the gov-jobs FastAPI backend.
# e.g. https://bdgc-gov-api.onrender.com
API_ORIGIN=

# Public URL of the main BD Garments Career portal (private-sector jobs).
NEXT_PUBLIC_MAIN_PORTAL_URL=https://www.bdgarmentscareer.com

# Where the browser should send API calls (relative = same origin proxy).
NEXT_PUBLIC_API_BASE=/api